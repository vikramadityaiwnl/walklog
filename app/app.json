{
  "expo": {
    "name": "walklog",
    "slug": "walklog",
    "version": "0.0.1",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "walklog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.thevikramaditya.walklog"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F1",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.thevikramaditya.walklog"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@react-native-firebase/app-check",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "./plugins/with-firebase-bom",
      "./plugins/with-firebase-ios-version"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/67a78fc3-8f0e-4c11-b3d4-35138f05e68c",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "extra": {
      "eas": {
        "projectId": "67a78fc3-8f0e-4c11-b3d4-35138f05e68c"
      }
    },
    "owner": "thevikramaditya"
  }
}
